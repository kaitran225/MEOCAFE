<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- HienXanh theme: cool slate canvas, high-contrast ink, one deep-teal accent,
       slate-blue secondary series, semantic status hues. Hairline borders instead
       of shadows; input borders reach 3:1 so editable fields stay findable.
       Each variant defines Color tokens; semantic brushes derive from them.
       Views reference brushes with DynamicResource so a theme switch applies live. -->

  <!-- Theme-independent tokens -->
  <BoxShadows x:Key="ShadowAppBar">0 1 2 0 #40000000</BoxShadows>
  <BoxShadows x:Key="ShadowContent">0 1 3 0 #30000000</BoxShadows>
  <BoxShadows x:Key="ShadowCard">0 1 2 0 #1F000000</BoxShadows>
  <BoxShadows x:Key="ShadowDialog">0 8 32 0 #66000000</BoxShadows>
  <BoxShadows x:Key="ShadowLogin">0 4 20 0 #40000000</BoxShadows>
  <BoxShadows x:Key="ShadowCardLight">0 1 2 0 #14000000</BoxShadows>
  <BoxShadows x:Key="ShadowCardSoft">0 1 2 0 #0D000000</BoxShadows>

  <ResourceDictionary.ThemeDictionaries>
    <!-- ============================ DARK (default) ============================ -->
    <ResourceDictionary x:Key="Dark">
      <!-- Primitive color tokens -->
      <Color x:Key="PrimaryColor">#4FB3A6</Color>
      <Color x:Key="PrimaryLightColor">#17302E</Color>
      <Color x:Key="PrimaryHoverColor">#5FC4B6</Color>
      <Color x:Key="PrimaryPressedColor">#3E9C90</Color>
      <Color x:Key="SecondaryColor">#93A8C6</Color>
      <Color x:Key="SecondaryLightColor">#1E2A38</Color>
      <Color x:Key="ErrorColor">#EC8B82</Color>
      <Color x:Key="ErrorBgColor">#33EC8B82</Color>
      <Color x:Key="SuccessColor">#6FC08A</Color>
      <Color x:Key="SuccessBgColor">#336FC08A</Color>
      <Color x:Key="WarningColor">#E4AF66</Color>
      <Color x:Key="InfoColor">#7FB2E0</Color>
      <Color x:Key="AccentAmberColor">#E4AF66</Color>
      <Color x:Key="DangerColor">#EC8B82</Color>
      <Color x:Key="DangerLightColor">#33EC8B82</Color>
      <Color x:Key="FocusColor">#7FD3C6</Color>

      <Color x:Key="BackgroundColor">#0F1316</Color>
      <Color x:Key="SurfaceColor">#161B1F</Color>
      <Color x:Key="SurfaceMutedColor">#1E242A</Color>
      <Color x:Key="BorderColor">#2B333A</Color>
      <Color x:Key="BorderStrongColor">#5E6B78</Color>
      <Color x:Key="BlackColor">#0A0D0F</Color>
      <Color x:Key="BlackSurfaceColor">#141A1E</Color>
      <Color x:Key="SidebarColor">#12171B</Color>
      <Color x:Key="OnSurfaceColor">#EDF2F6</Color>
      <Color x:Key="OnSurfaceMutedColor">#A3AFBA</Color>
      <Color x:Key="OnPrimaryColor">#0A1214</Color>

      <Color x:Key="NavSelectedColor">#4FB3A6</Color>
      <Color x:Key="SidebarBorderColor">#262F37</Color>
      <Color x:Key="SidebarHoverColor">#1B2229</Color>
      <Color x:Key="SidebarItemColor">#334FB3A6</Color>
      <Color x:Key="AppBarIconBgColor">#22FFFFFF</Color>
      <Color x:Key="AppBarUserBgColor">#18FFFFFF</Color>
      <Color x:Key="AppBarButtonBgColor">#30FFFFFF</Color>
      <Color x:Key="AppBarButtonBorderColor">#28FFFFFF</Color>

      <Color x:Key="OverlayDimColor">#CC080B0D</Color>
      <Color x:Key="OverlayDimStrongColor">#E6080B0D</Color>
      <Color x:Key="StockLowColor">#E4AF66</Color>
      <Color x:Key="AvailableColor">#6FC08A</Color>
      <Color x:Key="OccupiedColor">#E4AF66</Color>
      <Color x:Key="DarkBorderHoverColor">#5E6B78</Color>
      <Color x:Key="DarkTextSecondaryColor">#A9C7C1</Color>

      <!-- Semantic brushes -->
      <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
      <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
      <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
      <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
      <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource SecondaryLightColor}"/>
      <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}"/>

      <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
      <SolidColorBrush x:Key="ErrorBgBrush" Color="{StaticResource ErrorBgColor}"/>
      <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
      <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}"/>
      <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
      <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
      <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}"/>
      <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
      <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLightColor}"/>

      <SolidColorBrush x:Key="AvailableBrush" Color="{StaticResource AvailableColor}"/>
      <SolidColorBrush x:Key="OccupiedBrush" Color="{StaticResource OccupiedColor}"/>

      <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
      <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}"/>
      <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
      <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
      <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource BlackColor}"/>
      <SolidColorBrush x:Key="BlackSurfaceBrush" Color="{StaticResource BlackSurfaceColor}"/>
      <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
      <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}"/>
      <SolidColorBrush x:Key="OnSurfaceMutedBrush" Color="{StaticResource OnSurfaceMutedColor}"/>
      <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}"/>

      <SolidColorBrush x:Key="AppBarIconBgBrush" Color="{StaticResource AppBarIconBgColor}"/>
      <SolidColorBrush x:Key="AppBarUserBgBrush" Color="{StaticResource AppBarUserBgColor}"/>
      <SolidColorBrush x:Key="AppBarButtonBgBrush" Color="{StaticResource AppBarButtonBgColor}"/>
      <SolidColorBrush x:Key="AppBarButtonBorderBrush" Color="{StaticResource AppBarButtonBorderColor}"/>

      <SolidColorBrush x:Key="NavSelectedBrush" Color="{StaticResource NavSelectedColor}"/>
      <SolidColorBrush x:Key="NavSelectedFgBrush" Color="{StaticResource OnPrimaryColor}"/>
      <SolidColorBrush x:Key="SidebarBorderBrush" Color="{StaticResource SidebarBorderColor}"/>
      <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}"/>
      <SolidColorBrush x:Key="SidebarItemBrush" Color="{StaticResource SidebarItemColor}"/>

      <!-- Legacy dark tokens (aliases) -->
      <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource BackgroundColor}"/>
      <SolidColorBrush x:Key="DarkSurfaceBrush" Color="{StaticResource SurfaceColor}"/>
      <SolidColorBrush x:Key="DarkSurfaceAltBrush" Color="{StaticResource SurfaceMutedColor}"/>
      <SolidColorBrush x:Key="DarkBorderBrush" Color="{StaticResource BorderColor}"/>
      <SolidColorBrush x:Key="DarkBorderHoverBrush" Color="{StaticResource DarkBorderHoverColor}"/>
      <SolidColorBrush x:Key="DarkTextPrimaryBrush" Color="{StaticResource OnSurfaceColor}"/>
      <SolidColorBrush x:Key="DarkTextMutedBrush" Color="{StaticResource OnSurfaceMutedColor}"/>
      <SolidColorBrush x:Key="DarkTextSecondaryBrush" Color="{StaticResource DarkTextSecondaryColor}"/>

      <SolidColorBrush x:Key="OverlayDimBrush" Color="{StaticResource OverlayDimColor}"/>
      <SolidColorBrush x:Key="OverlayDimStrongBrush" Color="{StaticResource OverlayDimStrongColor}"/>

      <SolidColorBrush x:Key="StockLowBrush" Color="{StaticResource StockLowColor}"/>

      <SolidColorBrush x:Key="StatusBarAvailableBrush" Color="{StaticResource AvailableColor}"/>
      <SolidColorBrush x:Key="StatusBarOccupiedBrush" Color="{StaticResource OccupiedColor}"/>
      <SolidColorBrush x:Key="StatusBarReservedBrush" Color="{StaticResource ErrorColor}"/>

      <SolidColorBrush x:Key="BadgeNewBrush" Color="{StaticResource PrimaryLightColor}"/>
      <SolidColorBrush x:Key="BadgePendingBrush" Color="{StaticResource SecondaryLightColor}"/>
      <SolidColorBrush x:Key="BadgeAlertBrush" Color="{StaticResource ErrorBgColor}"/>
      <SolidColorBrush x:Key="BadgeBrush100" Color="#64FFFFFF"/>
      <SolidColorBrush x:Key="BadgeBrush200" Color="#40FFFFFF"/>
      <SolidColorBrush x:Key="BadgeBrush300" Color="{StaticResource ErrorColor}"/>
      <SolidColorBrush x:Key="BadgeBrush400" Color="{StaticResource SuccessColor}"/>

      <SolidColorBrush x:Key="KpiWarningBrush" Color="{StaticResource AccentAmberColor}"/>
      <SolidColorBrush x:Key="KpiWarningBgBrush" Color="{StaticResource AccentAmberColor}" Opacity="0.3"/>
      <SolidColorBrush x:Key="KpiErrorBrush" Color="{StaticResource ErrorColor}"/>
      <SolidColorBrush x:Key="KpiErrorBgBrush" Color="{StaticResource ErrorColor}" Opacity="0.2"/>
      <SolidColorBrush x:Key="KpiIconPrimaryBrush" Color="{StaticResource PrimaryColor}"/>
      <SolidColorBrush x:Key="KpiIconErrorBrush" Color="{StaticResource ErrorColor}"/>
      <SolidColorBrush x:Key="KpiIconWarningBrush" Color="{StaticResource AccentAmberColor}"/>
    </ResourceDictionary>

    <!-- ============================ LIGHT ============================ -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#0F6B62</Color>
      <Color x:Key="PrimaryLightColor">#E3F1EF</Color>
      <Color x:Key="PrimaryHoverColor">#0C5A52</Color>
      <Color x:Key="PrimaryPressedColor">#094740</Color>
      <Color x:Key="SecondaryColor">#3D5A78</Color>
      <Color x:Key="SecondaryLightColor">#E8EEF4</Color>
      <Color x:Key="ErrorColor">#A63429</Color>
      <Color x:Key="ErrorBgColor">#1AA63429</Color>
      <Color x:Key="SuccessColor">#2C6E45</Color>
      <Color x:Key="SuccessBgColor">#1A2C6E45</Color>
      <Color x:Key="WarningColor">#7C530C</Color>
      <Color x:Key="InfoColor">#2C5E86</Color>
      <Color x:Key="AccentAmberColor">#7C530C</Color>
      <Color x:Key="DangerColor">#A63429</Color>
      <Color x:Key="DangerLightColor">#1AA63429</Color>
      <Color x:Key="FocusColor">#0F6B62</Color>

      <Color x:Key="BackgroundColor">#F5F7F9</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="SurfaceMutedColor">#EDF1F5</Color>
      <Color x:Key="BorderColor">#D5DDE5</Color>
      <Color x:Key="BorderStrongColor">#8794A2</Color>
      <Color x:Key="BlackColor">#0F1316</Color>
      <Color x:Key="BlackSurfaceColor">#FFFFFF</Color>
      <Color x:Key="SidebarColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#101820</Color>
      <Color x:Key="OnSurfaceMutedColor">#55636F</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>

      <Color x:Key="NavSelectedColor">#0F6B62</Color>
      <Color x:Key="SidebarBorderColor">#E1E7EE</Color>
      <Color x:Key="SidebarHoverColor">#F0F4F8</Color>
      <Color x:Key="SidebarItemColor">#140F6B62</Color>
      <Color x:Key="AppBarIconBgColor">#12000000</Color>
      <Color x:Key="AppBarUserBgColor">#0D000000</Color>
      <Color x:Key="AppBarButtonBgColor">#1F000000</Color>
      <Color x:Key="AppBarButtonBorderColor">#1F000000</Color>

      <Color x:Key="OverlayDimColor">#99080B0D</Color>
      <Color x:Key="OverlayDimStrongColor">#CC080B0D</Color>
      <Color x:Key="StockLowColor">#7C530C</Color>
      <Color x:Key="AvailableColor">#2C6E45</Color>
      <Color x:Key="OccupiedColor">#7C530C</Color>
      <Color x:Key="DarkBorderHoverColor">#A9B5C2</Color>
      <Color x:Key="DarkTextSecondaryColor">#0F6B62</Color>

      <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
      <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
      <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
      <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
      <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
      <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource SecondaryLightColor}"/>
      <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}"/>

      <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
      <SolidColorBrush x:Key="ErrorBgBrush" Color="{StaticResource ErrorBgColor}"/>
      <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
      <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}"/>
      <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
      <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
      <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}"/>
      <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
      <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLightColor}"/>

      <SolidColorBrush x:Key="AvailableBrush" Color="{StaticResource AvailableColor}"/>
      <SolidColorBrush x:Key="OccupiedBrush" Color="{StaticResource OccupiedColor}"/>

      <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
      <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}"/>
      <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
      <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
      <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource BlackColor}"/>
      <SolidColorBrush x:Key="BlackSurfaceBrush" Color="{StaticResource BlackSurfaceColor}"/>
      <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
      <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}"/>
      <SolidColorBrush x:Key="OnSurfaceMutedBrush" Color="{StaticResource OnSurfaceMutedColor}"/>
      <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}"/>

      <SolidColorBrush x:Key="AppBarIconBgBrush" Color="{StaticResource AppBarIconBgColor}"/>
      <SolidColorBrush x:Key="AppBarUserBgBrush" Color="{StaticResource AppBarUserBgColor}"/>
      <SolidColorBrush x:Key="AppBarButtonBgBrush" Color="{StaticResource AppBarButtonBgColor}"/>
      <SolidColorBrush x:Key="AppBarButtonBorderBrush" Color="{StaticResource AppBarButtonBorderColor}"/>

      <SolidColorBrush x:Key="NavSelectedBrush" Color="{StaticResource NavSelectedColor}"/>
      <SolidColorBrush x:Key="NavSelectedFgBrush" Color="{StaticResource OnPrimaryColor}"/>
      <SolidColorBrush x:Key="SidebarBorderBrush" Color="{StaticResource SidebarBorderColor}"/>
      <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}"/>
      <SolidColorBrush x:Key="SidebarItemBrush" Color="{StaticResource SidebarItemColor}"/>

      <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource BackgroundColor}"/>
      <SolidColorBrush x:Key="DarkSurfaceBrush" Color="{StaticResource SurfaceColor}"/>
      <SolidColorBrush x:Key="DarkSurfaceAltBrush" Color="{StaticResource SurfaceMutedColor}"/>
      <SolidColorBrush x:Key="DarkBorderBrush" Color="{StaticResource BorderColor}"/>
      <SolidColorBrush x:Key="DarkBorderHoverBrush" Color="{StaticResource DarkBorderHoverColor}"/>
      <SolidColorBrush x:Key="DarkTextPrimaryBrush" Color="{StaticResource OnSurfaceColor}"/>
      <SolidColorBrush x:Key="DarkTextMutedBrush" Color="{StaticResource OnSurfaceMutedColor}"/>
      <SolidColorBrush x:Key="DarkTextSecondaryBrush" Color="{StaticResource DarkTextSecondaryColor}"/>

      <SolidColorBrush x:Key="OverlayDimBrush" Color="{StaticResource OverlayDimColor}"/>
      <SolidColorBrush x:Key="OverlayDimStrongBrush" Color="{StaticResource OverlayDimStrongColor}"/>

      <SolidColorBrush x:Key="StockLowBrush" Color="{StaticResource StockLowColor}"/>

      <SolidColorBrush x:Key="StatusBarAvailableBrush" Color="{StaticResource AvailableColor}"/>
      <SolidColorBrush x:Key="StatusBarOccupiedBrush" Color="{StaticResource OccupiedColor}"/>
      <SolidColorBrush x:Key="StatusBarReservedBrush" Color="{StaticResource ErrorColor}"/>

      <SolidColorBrush x:Key="BadgeNewBrush" Color="{StaticResource PrimaryLightColor}"/>
      <SolidColorBrush x:Key="BadgePendingBrush" Color="{StaticResource SecondaryLightColor}"/>
      <SolidColorBrush x:Key="BadgeAlertBrush" Color="{StaticResource ErrorBgColor}"/>
      <SolidColorBrush x:Key="BadgeBrush100" Color="#14000000"/>
      <SolidColorBrush x:Key="BadgeBrush200" Color="#24000000"/>
      <SolidColorBrush x:Key="BadgeBrush300" Color="{StaticResource ErrorColor}"/>
      <SolidColorBrush x:Key="BadgeBrush400" Color="{StaticResource SuccessColor}"/>

      <SolidColorBrush x:Key="KpiWarningBrush" Color="{StaticResource AccentAmberColor}"/>
      <SolidColorBrush x:Key="KpiWarningBgBrush" Color="{StaticResource AccentAmberColor}" Opacity="0.25"/>
      <SolidColorBrush x:Key="KpiErrorBrush" Color="{StaticResource ErrorColor}"/>
      <SolidColorBrush x:Key="KpiErrorBgBrush" Color="{StaticResource ErrorColor}" Opacity="0.18"/>
      <SolidColorBrush x:Key="KpiIconPrimaryBrush" Color="{StaticResource PrimaryColor}"/>
      <SolidColorBrush x:Key="KpiIconErrorBrush" Color="{StaticResource ErrorColor}"/>
      <SolidColorBrush x:Key="KpiIconWarningBrush" Color="{StaticResource AccentAmberColor}"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
