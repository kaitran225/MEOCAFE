<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="POS.Avalonia.Controls.Numpad"
             x:Name="Root">
  <StackPanel Spacing="{DynamicResource Spacing8}">
    <Border Background="{StaticResource SurfaceMutedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CornerRadius8}"
            Padding="{DynamicResource Margin16}"
            MinHeight="48">
      <TextBlock Text="{Binding #Root.DisplayValue}"
                 FontSize="{DynamicResource LargeTitleFontSize}"
                 FontWeight="{StaticResource TitleFontWeight}"
                 Foreground="{StaticResource OnSurfaceBrush}"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"/>
    </Border>
    <UniformGrid Columns="3"
                 Rows="4">
      <UniformGrid.Styles>
        <Style Selector="Button.numpad">
          <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
          <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
          <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius8}"/>
          <Setter Property="Height" Value="48"/>
          <Setter Property="Margin" Value="2"/>
          <Setter Property="FontSize" Value="{DynamicResource SubtitleFontSize}"/>
          <Setter Property="FontWeight" Value="{StaticResource SubtitleFontWeight}"/>
          <Setter Property="HorizontalContentAlignment" Value="Center"/>
          <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
      </UniformGrid.Styles>
      <Button Classes="numpad" Content="7" Command="{Binding #Root.AppendCommand}" CommandParameter="7"/>
      <Button Classes="numpad" Content="8" Command="{Binding #Root.AppendCommand}" CommandParameter="8"/>
      <Button Classes="numpad" Content="9" Command="{Binding #Root.AppendCommand}" CommandParameter="9"/>
      <Button Classes="numpad" Content="4" Command="{Binding #Root.AppendCommand}" CommandParameter="4"/>
      <Button Classes="numpad" Content="5" Command="{Binding #Root.AppendCommand}" CommandParameter="5"/>
      <Button Classes="numpad" Content="6" Command="{Binding #Root.AppendCommand}" CommandParameter="6"/>
      <Button Classes="numpad" Content="1" Command="{Binding #Root.AppendCommand}" CommandParameter="1"/>
      <Button Classes="numpad" Content="2" Command="{Binding #Root.AppendCommand}" CommandParameter="2"/>
      <Button Classes="numpad" Content="3" Command="{Binding #Root.AppendCommand}" CommandParameter="3"/>
      <Button Classes="numpad" Content="0" Command="{Binding #Root.AppendCommand}" CommandParameter="0"/>
      <Button Classes="numpad" Content="00" Command="{Binding #Root.AppendCommand}" CommandParameter="00"/>
      <Button Classes="numpad" Command="{Binding #Root.BackspaceCommand}">
        <PathIcon Data="M22 3H7c-.69 0-1.23.35-1.59.88L0 12l5.41 8.11c.36.53.9.89 1.59.89h15c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-3 12.59L17.59 17 14 13.41 10.41 17 9 15.59 12.59 12 9 8.41 10.41 7 14 10.59 17.59 7 19 8.41 15.41 12 19 15.59z"
                 Width="16" Height="16"
                 Foreground="{StaticResource OnSurfaceBrush}"/>
      </Button>
    </UniformGrid>
    <Button Command="{Binding #Root.ClearCommand}"
            Content="Clear"
            Background="{StaticResource ErrorBgBrush}"
            Foreground="{StaticResource ErrorBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CornerRadius8}"
            Height="40"
            FontSize="{DynamicResource BodyFontSize}"
            FontWeight="{StaticResource SubtitleFontWeight}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"/>
  </StackPanel>
</UserControl>
