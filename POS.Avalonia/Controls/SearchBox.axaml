<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="POS.Avalonia.Controls.SearchBox"
             x:Name="Root">
  <Border Background="{DynamicResource DarkSurfaceBrush}"
          BorderBrush="{DynamicResource DarkBorderBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource CornerRadius12}"
          Padding="12,0">
    <Grid ColumnDefinitions="Auto,*">
      <PathIcon Grid.Column="0"
                Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                Width="16"
                Height="16"
                Foreground="{DynamicResource DarkTextMutedBrush}"
                VerticalAlignment="Center"
                Margin="0,0,8,0"/>
      <TextBox Grid.Column="1"
               Text="{Binding #Root.Text, Mode=TwoWay}"
               Watermark="{Binding #Root.Watermark}"
               BorderThickness="0"
               Background="Transparent"
               VerticalAlignment="Center"
               Padding="0,8"/>
    </Grid>
  </Border>
</UserControl>
