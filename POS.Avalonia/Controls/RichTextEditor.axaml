<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:POS.Avalonia.Controls"
             x:Class="POS.Avalonia.Controls.RichTextEditor"
             x:Name="Root">
  <StackPanel Spacing="8">
    <!-- Toolbar -->
    <StackPanel Orientation="Horizontal" Spacing="6">
      <Button Content="B" FontWeight="Bold" Command="{Binding #Root.BoldCommand}"
              Padding="10,4" MinHeight="28" CornerRadius="6"
              Background="{DynamicResource SurfaceMutedBrush}" Foreground="{DynamicResource OnSurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              ToolTip.Tip="Bold (wraps selection with &lt;b&gt;)"/>
      <Button Content="I" FontStyle="Italic" Command="{Binding #Root.ItalicCommand}"
              Padding="10,4" MinHeight="28" CornerRadius="6"
              Background="{DynamicResource SurfaceMutedBrush}" Foreground="{DynamicResource OnSurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              ToolTip.Tip="Italic (wraps selection with &lt;i&gt;)"/>
      <Button Command="{Binding #Root.UnderlineCommand}"
              Padding="10,4" MinHeight="28" CornerRadius="6"
              Background="{DynamicResource SurfaceMutedBrush}" Foreground="{DynamicResource OnSurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              ToolTip.Tip="Underline (wraps selection with &lt;u&gt;)">
        <TextBlock Text="U" TextDecorations="Underline"/>
      </Button>
      <Button Content="• List" Command="{Binding #Root.BulletCommand}"
              Padding="10,4" MinHeight="28" CornerRadius="6"
              Background="{DynamicResource SurfaceMutedBrush}" Foreground="{DynamicResource OnSurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              ToolTip.Tip="Toggle bullet on selected lines"/>

      <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="2,2"/>

      <ComboBox ItemsSource="{Binding #Root.Mentions}"
                SelectedItem="{Binding #Root.SelectedMention}"
                PlaceholderText="Link ingredient…"
                MinWidth="190" MinHeight="28" VerticalAlignment="Center"
                Background="{DynamicResource SurfaceMutedBrush}"
                Foreground="{DynamicResource OnSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"/>
      <Button Content="Insert" Command="{Binding #Root.InsertMentionCommand}"
              Padding="12,4" MinHeight="28" CornerRadius="6" Classes="primary"
              ToolTip.Tip="Inserts [[name]] which links to the ingredient list"/>
    </StackPanel>

    <!-- Source editor -->
    <TextBox x:Name="EditorBox"
             Text="{Binding #Root.Html, Mode=TwoWay}"
             AcceptsReturn="True" TextWrapping="Wrap"
             MinHeight="76" MaxHeight="110"
             Background="{DynamicResource SurfaceBrush}"
             Foreground="{DynamicResource OnSurfaceBrush}"
             BorderBrush="{DynamicResource BorderBrush}"
             Watermark="Type the step… (blank lines become line breaks; use the toolbar for formatting)"/>

    <!-- Live preview -->
    <Border IsVisible="{Binding #Root.Html, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Background="{DynamicResource SurfaceMutedBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="10,8">
      <StackPanel Spacing="4">
        <TextBlock Text="Preview" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
        <controls:RichTextBlock Html="{Binding #Root.Html}" TextWrapping="Wrap"
                                FontSize="13" Foreground="{DynamicResource OnSurfaceBrush}"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
