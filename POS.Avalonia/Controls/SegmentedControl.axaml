<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="POS.Avalonia.Controls.SegmentedControl"
             x:Name="Root">
  <ListBox ItemsSource="{Binding #Root.ItemsSource}"
           SelectedIndex="{Binding #Root.SelectedIndex}"
           Background="Transparent" BorderThickness="0" Padding="0"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="4"/>
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.Styles>
      <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius8}"/>
        <Setter Property="Margin" Value="0"/>
      </Style>
      <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}"/>
      </Style>
      <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource DarkSurfaceAltBrush}"/>
      </Style>
    </ListBox.Styles>
    <ListBox.ItemTemplate>
      <DataTemplate>
        <TextBlock Text="{Binding}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"/>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
