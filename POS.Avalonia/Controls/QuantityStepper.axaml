<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="POS.Avalonia.Controls.QuantityStepper"
             x:Name="Root">
  <StackPanel Orientation="Horizontal"
              Spacing="{DynamicResource Spacing4}">
    <Button Command="{Binding #Root.DecrementCommand}"
            Width="32" Height="32"
            Padding="0"
            Background="{DynamicResource PrimaryBrush}"
            Foreground="{DynamicResource OnPrimaryBrush}"
            CornerRadius="{DynamicResource CornerRadius4}"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center">
      <PathIcon Data="{StaticResource IconSubtract}"
                Width="14" Height="14"
                Foreground="{DynamicResource OnPrimaryBrush}"/>
    </Button>
    <TextBlock Text="{Binding #Root.Value}"
               MinWidth="32"
               TextAlignment="Center"
               FontSize="{DynamicResource BodyFontSize}"
               FontWeight="{StaticResource SubtitleFontWeight}"
               Foreground="{DynamicResource OnSurfaceBrush}"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"/>
    <Button Command="{Binding #Root.IncrementCommand}"
            Width="32" Height="32"
            Padding="0"
            Background="{DynamicResource PrimaryBrush}"
            Foreground="{DynamicResource OnPrimaryBrush}"
            CornerRadius="{DynamicResource CornerRadius4}"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center">
      <PathIcon Data="{StaticResource IconAdd}"
                Width="14" Height="14"
                Foreground="{DynamicResource OnPrimaryBrush}"/>
    </Button>
  </StackPanel>
</UserControl>
