<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:POS.Avalonia.ViewModels"
             xmlns:core="using:POS.Core.Models"
             xmlns:controls="using:POS.Avalonia.Controls"
             xmlns:conv="using:POS.Avalonia.Converters"
             x:Class="POS.Avalonia.Views.InventoryView" x:Name="Root" x:DataType="vm:InventoryViewModel"
             Background="{DynamicResource BackgroundBrush}">
  <UserControl.Resources>
    <conv:IdInListConverter x:Key="IdInListConverter"/>
    <conv:StockBarMaximumConverter x:Key="StockBarMaximumConverter"/>
  </UserControl.Resources>
  <Panel>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
      <!-- Header -->
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1" Padding="24,20" Margin="0,0,0,16">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Inventory &amp; Stock" FontSize="24" FontWeight="Bold"
                     Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Command="{Binding LoadCommand}" Padding="12,8" BorderThickness="0" Classes="secondary">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16"/>
              <TextBlock Text="Refresh" VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="4" Margin="0,0,0,8"/>

      <!-- KPI row -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="24" Margin="24,0,24,16">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource CornerRadius12}"
                Padding="20,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MinWidth="140">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource PrimaryBrush}" Opacity="0.2">
              <PathIcon Data="{StaticResource IconInventory}" Width="20" Height="20"
                        Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Items.Count}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceBrush}"/>
              <TextBlock Text="Total Items" FontSize="12" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource CornerRadius12}"
                Padding="20,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MinWidth="140">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource KpiWarningBgBrush}">
              <PathIcon Data="{StaticResource IconWarning}" Width="20" Height="20"
                        Foreground="{DynamicResource KpiIconWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding LowStockItems.Count}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceBrush}"/>
              <TextBlock Text="Low Stock" FontSize="12" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource CornerRadius12}"
                Padding="20,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MinWidth="140">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource KpiErrorBgBrush}">
              <PathIcon Data="{StaticResource IconInfo}" Width="20" Height="20"
                        Foreground="{DynamicResource KpiIconErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Spacing="2">
              <TextBlock Text="—" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceBrush}"/>
              <TextBlock Text="Out of Stock" FontSize="12" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Low Stock Alert -->
      <Border Grid.Row="3" Background="{DynamicResource ErrorBgBrush}" CornerRadius="{DynamicResource CornerRadius8}"
              Padding="16,12" Margin="24,0,24,8" IsVisible="{Binding LowStockItems.Count}">
        <Grid ColumnDefinitions="Auto,*">
          <PathIcon Data="{StaticResource IconWarning}" Width="18" Height="18"
                    Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <ItemsControl Grid.Column="1" ItemsSource="{Binding LowStockItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:MenuItem">
                <Border Background="{DynamicResource BadgeAlertBrush}" CornerRadius="100"
                        Padding="10,4" Margin="0,2,8,2" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Quantity, StringFormat='({0} left)'}"
                               FontSize="12" Foreground="{DynamicResource OnSurfaceMutedBrush}"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <!-- Search + category filter -->
      <Grid Grid.Row="4" ColumnDefinitions="240,*,Auto" Margin="24,0,24,12" IsVisible="{Binding !IsLoading}">
        <controls:SearchBox Grid.Column="0" Text="{Binding SearchText}" Watermark="Search items..."/>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" Margin="16,0,0,0"
                  SelectedItem="{Binding SelectedCategory}" MinWidth="160" HorizontalAlignment="Left"
                  Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource OnSurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="core:Category">
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="2" Command="{Binding SelectAllCategoriesCommand}" Padding="10,8" BorderThickness="0" Classes="secondary">
          <TextBlock Text="All categories" FontSize="12"/>
        </Button>
      </Grid>

      <!-- Table card -->
      <controls:Card Grid.Row="5" Padding="24" Margin="24,0,24,0"
              IsVisible="{Binding !IsLoading}">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock Grid.Row="0" Text="All Inventory Items" FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource OnSurfaceBrush}" Margin="0,0,0,12"/>

          <!-- Table header: checkbox, name, category, in stock, reorder, unit, stock bar, status, actions -->
          <Border Grid.Row="1" Padding="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,2*,*,Auto,Auto,Auto,100,100,Auto">
              <CheckBox Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"
                       Command="{Binding ToggleSelectAllCommand}"/>
              <TextBlock Grid.Column="1" Text="Item Name" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
              <TextBlock Grid.Column="2" Text="Category" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
              <TextBlock Grid.Column="3" Text="In Stock" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource OnSurfaceMutedBrush}" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="4" Text="Reorder" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource OnSurfaceMutedBrush}" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="5" Text="Unit" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource OnSurfaceMutedBrush}" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="6" Text="Stock" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource OnSurfaceMutedBrush}" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="7" Text="Status" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource OnSurfaceMutedBrush}" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="8" Text="Actions" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource OnSurfaceMutedBrush}" HorizontalAlignment="Center"/>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding PagedItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:MenuItem">
                  <Border Padding="12,10" Margin="0,1" CornerRadius="{DynamicResource CornerRadius8}"
                          Background="Transparent">
                    <Border.Styles>
                      <Style Selector="Border:pointerover">
                        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                      </Style>
                    </Border.Styles>
                    <Grid ColumnDefinitions="Auto,2*,*,Auto,Auto,Auto,100,100,Auto">
                      <CheckBox Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"
                                Command="{Binding #Root.DataContext.ToggleSelectItemCommand}"
                                CommandParameter="{Binding}">
                        <CheckBox.IsChecked>
                          <MultiBinding Converter="{StaticResource IdInListConverter}">
                            <Binding Path="Id"/>
                            <Binding ElementName="Root" Path="DataContext.SelectedIds"/>
                          </MultiBinding>
                        </CheckBox.IsChecked>
                      </CheckBox>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SellPrice, StringFormat='{}{0:N0} ₫'}"
                                   FontSize="11" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Category.Name, FallbackValue='—'}"
                                 FontSize="13" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="3" Text="{Binding Quantity}" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource OnSurfaceBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="4" Text="{Binding ReorderLevel}"
                                 FontSize="13" Foreground="{DynamicResource OnSurfaceMutedBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="5" Text="units" FontSize="12"
                                 Foreground="{DynamicResource OnSurfaceMutedBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Border Grid.Column="6" Height="8" CornerRadius="4" VerticalAlignment="Center"
                              Background="{DynamicResource SurfaceMutedBrush}" MinWidth="60">
                        <Border.Child>
                          <ProgressBar Minimum="0" VerticalAlignment="Stretch" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       Background="Transparent" BorderThickness="0"
                                       ClipToBounds="True">
                            <ProgressBar.Value>
                              <Binding Path="Quantity"/>
                            </ProgressBar.Value>
                            <ProgressBar.Maximum>
                              <MultiBinding Converter="{StaticResource StockBarMaximumConverter}">
                                <Binding Path="Quantity"/>
                                <Binding Path="ReorderLevel"/>
                              </MultiBinding>
                            </ProgressBar.Maximum>
                          </ProgressBar>
                        </Border.Child>
                      </Border>
                      <Panel Grid.Column="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:StatusBadge Text="In Stock" BadgeBrush="{DynamicResource SuccessBrush}">
                          <controls:StatusBadge.IsVisible>
                            <Binding Path="Quantity" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                          </controls:StatusBadge.IsVisible>
                        </controls:StatusBadge>
                        <controls:StatusBadge Text="Low Stock" BadgeBrush="{DynamicResource StockLowBrush}">
                          <controls:StatusBadge.IsVisible>
                            <Binding Path="Quantity" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                          </controls:StatusBadge.IsVisible>
                        </controls:StatusBadge>
                      </Panel>
                      <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="4"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Command="{Binding #Root.DataContext.OpenAdjustCommand}" CommandParameter="{Binding}" Padding="8,6" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" ToolTip.Tip="Adjust quantity">
                          <PathIcon Data="{StaticResource IconEdit}" Width="14" Height="14"
                                    Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                        </Button>
                        <Button Command="{Binding #Root.DataContext.OpenStockInCommand}" CommandParameter="{Binding}" Padding="8,6" BorderThickness="0" ToolTip.Tip="Add stock" Classes="secondary">
                          <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14"
                                    Foreground="{DynamicResource PrimaryBrush}"/>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </controls:Card>

      <!-- Pagination -->
      <Border Grid.Row="6" Padding="24,12" Margin="24,0"
              IsVisible="{Binding !IsLoading}">
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource OnSurfaceMutedBrush}">
            <Run Text="Showing "/>
            <Run Text="{Binding TotalFiltered}"/>
            <Run Text=" items"/>
          </TextBlock>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding PrevPageCommand}" Content="Previous" Padding="12,6" IsEnabled="{Binding HasPrevPage}" Classes="secondary"/>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{Binding CurrentPage}" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource OnSurfaceBrush}"/>
              <TextBlock Text=" of " FontSize="12" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
              <TextBlock Text="{Binding TotalPages}" FontSize="13"
                         Foreground="{DynamicResource OnSurfaceBrush}"/>
            </StackPanel>
            <Button Command="{Binding NextPageCommand}" Content="Next" Padding="12,6" IsEnabled="{Binding HasNextPage}" Classes="secondary"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Empty state -->
      <controls:EmptyState Grid.Row="5" Margin="24,0" VerticalAlignment="Top"
                           Icon="{StaticResource IconInventory}"
                           Title="No inventory items found"
                           Hint="Điều chỉnh bộ lọc hoặc thêm mặt hàng mới."
                           IsVisible="{Binding NoItems}"/>
    </Grid>

    <!-- Modals -->
    <controls:ModalOverlay IsOpen="{Binding IsAdjustOpen}" Title="Adjust Quantity">
      <StackPanel Spacing="16" MinWidth="340">
        <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="{DynamicResource CornerRadius8}"
                Padding="16,12">
          <StackPanel Spacing="4">
            <TextBlock Text="Selected Item" FontSize="12" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
            <TextBlock Text="{Binding SelectedItem.Name}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource OnSurfaceBrush}"/>
            <TextBlock FontSize="12" Foreground="{DynamicResource OnSurfaceMutedBrush}">
              <Run Text="Current stock: "/><Run Text="{Binding SelectedItem.Quantity}"/>
            </TextBlock>
          </StackPanel>
        </Border>
        <StackPanel Spacing="4">
          <TextBlock Text="Adjustment (+/-)" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource OnSurfaceBrush}"/>
          <TextBox Text="{Binding AdjustQuantityText}" Watermark="e.g. +10 or -5"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Reason" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource OnSurfaceBrush}"/>
          <TextBox Text="{Binding AdjustReason}" Watermark="Reason for adjustment"/>
          <TextBlock Text="{Binding FormError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding CloseAdjustCommand}" Padding="16,10" Classes="secondary">
              <TextBlock Text="Cancel"/>
            </Button>
            <Button Command="{Binding ConfirmAdjustCommand}" Padding="16,10" Classes="primary">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14"
                          Foreground="{DynamicResource OnPrimaryBrush}"/>
                <TextBlock Text="Apply"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </controls:ModalOverlay>

    <controls:ModalOverlay IsOpen="{Binding IsStockInOpen}" Title="Receive Stock">
      <StackPanel Spacing="16" MinWidth="340">
        <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="{DynamicResource CornerRadius8}"
                Padding="16,12">
          <StackPanel Spacing="4">
            <TextBlock Text="Selected Item" FontSize="12" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
            <TextBlock Text="{Binding SelectedItem.Name}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource OnSurfaceBrush}"/>
            <TextBlock FontSize="12" Foreground="{DynamicResource OnSurfaceMutedBrush}">
              <Run Text="Current stock: "/><Run Text="{Binding SelectedItem.Quantity}"/>
            </TextBlock>
          </StackPanel>
        </Border>
        <StackPanel Spacing="4">
          <TextBlock Text="Quantity to receive" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource OnSurfaceBrush}"/>
          <TextBox Text="{Binding StockInQuantityText}" Watermark="Enter quantity"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Reference" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource OnSurfaceBrush}"/>
          <TextBox Text="{Binding StockInReference}" Watermark="PO number / supplier ref"/>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding CloseStockInCommand}" Padding="16,10" Classes="secondary">
              <TextBlock Text="Cancel"/>
            </Button>
            <Button Command="{Binding ConfirmStockInCommand}" Padding="16,10" Classes="primary">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14"
                          Foreground="{DynamicResource OnPrimaryBrush}"/>
                <TextBlock Text="Receive"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </controls:ModalOverlay>
  </Panel>
</UserControl>
