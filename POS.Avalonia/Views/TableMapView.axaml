<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:POS.Avalonia.ViewModels"
             xmlns:models="using:POS.Avalonia.Models"
             xmlns:conv="using:POS.Avalonia.Converters"
             xmlns:controls="using:POS.Avalonia.Controls"
             x:Class="POS.Avalonia.Views.TableMapView"
             x:Name="Root"
             x:DataType="vm:TableMapViewModel"
             Background="{DynamicResource BackgroundBrush}">
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <!-- Header: title + zone dropdown + Add Table / Refresh -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="24,20">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceBrush}"/>
          <TextBlock Text="Manage your floor layout and table availability."
                     FontSize="13" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
        </StackPanel>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}"
                  PlaceholderText="Zone" MinWidth="160" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Background="{DynamicResource SurfaceMutedBrush}" Foreground="{DynamicResource OnSurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Command="{Binding OpenAddTableCommand}" IsVisible="{Binding IsManager}" Classes="primary">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconAdd}" Foreground="{DynamicResource OnPrimaryBrush}" Width="16" Height="16"/>
              <TextBlock Text="Add Table"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding LoadCommand}" Classes="secondary">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconRefresh}" Foreground="{DynamicResource OnSurfaceBrush}" Width="16" Height="16"/>
              <TextBlock Text="Refresh"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="4"/>

    <!-- Legend -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource CornerRadius8}"
            Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="24,12,24,0">
      <StackPanel Orientation="Horizontal" Spacing="24">
        <TextBlock Text="Status:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceMutedBrush}" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource StatusBarAvailableBrush}"/>
          <TextBlock Text="Available" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource StatusBarOccupiedBrush}"/>
          <TextBlock Text="Occupied" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource StatusBarReservedBrush}"/>
          <TextBlock Text="Reserved" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Table grid + empty state -->
    <Grid Grid.Row="3" Margin="24,16" IsVisible="{Binding !IsLoading}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding FilteredCards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:TableMapCardItem">
            <Border Width="220" MinHeight="160" Margin="0,0,16,16"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="{DynamicResource CornerRadius12}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    BoxShadow="0 2 8 0 #10000000"
                    ClipToBounds="True">
              <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                <!-- Status color bar (full width top) -->
                <Border Grid.Row="0" Grid.ColumnSpan="2" Height="4" CornerRadius="12,12,0,0">
                  <Border.Background>
                    <Binding Path="Table.Status">
                      <Binding.Converter>
                        <conv:TableStatusToBrushConverter
                            AvailableBrush="{StaticResource StatusBarAvailableBrush}"
                            OccupiedBrush="{StaticResource StatusBarOccupiedBrush}"
                            ReservedBrush="{StaticResource StatusBarReservedBrush}"/>
                      </Binding.Converter>
                    </Binding>
                  </Border.Background>
                </Border>

                <!-- Card content -->
                <Button Grid.Row="1" Grid.Column="0" Command="{Binding #Root.DataContext.NewOrderAtTableCommand}" CommandParameter="{Binding}" Padding="12,10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Cursor="Hand" Classes="ghost">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="40" Height="40" CornerRadius="{DynamicResource CornerRadius8}"
                              Background="{DynamicResource SurfaceMutedBrush}">
                        <PathIcon Data="{StaticResource IconTableRestaurant}" Width="20" Height="20"
                                  Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Table.Name}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource OnSurfaceBrush}"/>
                        <TextBlock Text="{Binding Table.Zone}" FontSize="11"
                                   Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                      </StackPanel>
                    </StackPanel>
                    <!-- Status badge -->
                    <Border HorizontalAlignment="Left" CornerRadius="4" Padding="8,4"
                            Background="{DynamicResource SurfaceMutedBrush}">
                      <Border.Background>
                        <Binding Path="Table.Status">
                          <Binding.Converter>
                            <conv:TableStatusToBrushConverter
                                AvailableBrush="{StaticResource StatusBarAvailableBrush}"
                                OccupiedBrush="{StaticResource StatusBarOccupiedBrush}"
                                ReservedBrush="{StaticResource StatusBarReservedBrush}"/>
                          </Binding.Converter>
                        </Binding>
                      </Border.Background>
                      <TextBlock Text="{Binding Table.Status}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource OnSurfaceBrush}"/>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Seats" FontSize="10" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <PathIcon Data="{StaticResource IconPerson}" Width="12" Height="12"
                                    Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                          <TextBlock Text="{Binding Table.Capacity}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{DynamicResource OnSurfaceBrush}"/>
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2" IsVisible="{Binding ElapsedDisplay, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="Elapsed" FontSize="10" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                        <TextBlock Text="{Binding ElapsedDisplay}" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Button>

                <!-- Three-dot menu -->
                <Button Grid.Row="1" Grid.Column="1" Padding="8" VerticalAlignment="Top" HorizontalAlignment="Right" IsVisible="{Binding #Root.DataContext.IsManager}" Classes="ghost">
                  <PathIcon Data="{StaticResource IconMoreVertical}" Width="20" Height="20"
                            Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="Reserve" Command="{Binding #Root.DataContext.ReserveTableCommand}"
                                CommandParameter="{Binding Table}"/>
                      <MenuItem Header="Edit" Command="{Binding #Root.DataContext.OpenEditTableCommand}"
                                CommandParameter="{Binding Table}"/>
                      <MenuItem Header="Delete" Command="{Binding #Root.DataContext.DeleteTableCommand}"
                                CommandParameter="{Binding Table}"
                                Foreground="{DynamicResource ErrorBrush}"/>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>
      <Border Padding="48,32" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource CornerRadius12}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            IsVisible="{Binding NoTables}">
        <StackPanel HorizontalAlignment="Center" Spacing="12">
          <PathIcon Data="{StaticResource IconTableRestaurant}" Width="40" Height="40"
                    Foreground="{DynamicResource OnSurfaceMutedBrush}" Opacity="0.4" HorizontalAlignment="Center"/>
          <TextBlock Text="No tables in this zone" FontSize="18" Foreground="{DynamicResource OnSurfaceMutedBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="Change zone or add your first table to get started."
                     FontSize="13" Foreground="{DynamicResource OnSurfaceMutedBrush}" Opacity="0.7" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <controls:ModalOverlay IsOpen="{Binding IsTableEditOpen}" Title="Table Details">
      <StackPanel Spacing="16" MinWidth="320">
        <StackPanel Spacing="6">
          <TextBlock Text="Name" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
          <TextBox Text="{Binding TableFormName}" Watermark="e.g. Table 1"/>
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="Capacity" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
          <TextBox Text="{Binding TableFormCapacity}" Watermark="e.g. 4"/>
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Text="Zone / Floor" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
          <TextBox Text="{Binding TableFormZone}" Watermark="e.g. Main floor"/>
        </StackPanel>
        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CloseTableEditCommand}" BorderThickness="0" Padding="16,8" Classes="secondary"/>
          <Button Command="{Binding SaveTableCommand}" Padding="16,8" Classes="primary">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconCheck}" Foreground="{DynamicResource OnPrimaryBrush}" Width="14" Height="14"/>
              <TextBlock Text="Save"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </controls:ModalOverlay>
  </Grid>
</UserControl>
