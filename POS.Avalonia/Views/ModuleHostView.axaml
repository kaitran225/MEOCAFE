<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:POS.Avalonia.ViewModels"
             x:Class="POS.Avalonia.Views.ModuleHostView"
             x:DataType="vm:ModuleHostViewModel"
             Background="{StaticResource BackgroundBrush}">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
      <Grid ColumnDefinitions="Auto,*">
        <Button Command="{Binding GoBackCommand}" Classes="secondary" Padding="12,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6 1.41-1.41z" Width="18" Height="18"/>
            <TextBlock Text="Quay lại" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                   Margin="16,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource OnSurfaceBrush}"/>
      </Grid>
    </Border>
    <ContentControl Grid.Row="1" Content="{Binding ModuleContent}"/>
  </Grid>
</UserControl>
