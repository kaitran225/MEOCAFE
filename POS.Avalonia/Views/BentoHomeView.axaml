<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:POS.Avalonia.ViewModels"
             xmlns:controls="using:POS.Avalonia.Controls"
             xmlns:conv="using:POS.Avalonia.Converters"
             xmlns:dconv="using:Avalonia.Data.Converters"
             x:Class="POS.Avalonia.Views.BentoHomeView"
             x:Name="Root"
             x:DataType="vm:BentoHomeViewModel"
             Background="{DynamicResource BackgroundBrush}"
             SizeChanged="OnRootSizeChanged">
  <UserControl.Resources>
    <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter"/>

    <DataTemplate x:Key="BentoTileTemplate" DataType="vm:BentoTile" x:DataType="vm:BentoTile">
      <Button Classes="bento-tile" Click="OnTileClick" Cursor="Hand">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Classes="bento-plate">
            <PathIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                      Width="22" Height="22"
                      Foreground="{DynamicResource PrimaryBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Classes="bento-title" Text="{Binding Title}"/>
            <TextBlock Classes="bento-subtitle" Text="{Binding Subtitle}"
                       IsVisible="{Binding Subtitle, Converter={x:Static dconv:StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.bento-tile">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.bento-tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
    </Style>
    <Style Selector="Button.bento-tile:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
    </Style>
    <Style Selector="Button.bento-tile:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Border.bento-plate">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="Button.bento-tile:pointerover Border.bento-plate">
      <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
    </Style>

    <Style Selector="TextBlock.bento-title">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.bento-subtitle">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="LineHeight" Value="17"/>
      <Setter Property="Foreground" Value="{DynamicResource OnSurfaceMutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="28" Margin="32,28,32,40" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6">
          <TextBlock Text="HienXanh"
                     FontSize="{DynamicResource LargeTitleFontSize}" FontWeight="Bold"
                     Foreground="{DynamicResource OnSurfaceBrush}"/>
          <TextBlock Text="{Binding TodayCaption}"
                     FontSize="{DynamicResource BodyFontSize}"
                     Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
        </StackPanel>
      </Grid>

      <ItemsControl ItemsSource="{Binding Tiles}"
                    ItemTemplate="{StaticResource BentoTileTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:BentoGridPanel Columns="4" Gap="16" SquareCells="True"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
