<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:POS.Avalonia.ViewModels"
             xmlns:controls="using:POS.Avalonia.Controls"
             xmlns:models="using:POS.Avalonia.Models"
             xmlns:core="using:POS.Core.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="POS.Avalonia.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Background="{DynamicResource BackgroundBrush}">
  <UserControl.Styles>
    <Style Selector="Border.chart-bar">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
    </Style>
    <Style Selector="Border.chart-bar.peak">
      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="{DynamicResource Spacing24}" Margin="{DynamicResource Margin32}">

      <!-- Header -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="Tổng quan" FontSize="{DynamicResource LargeTitleFontSize}" FontWeight="Bold"
                     Foreground="{DynamicResource OnSurfaceBrush}"/>
          <TextBlock Text="{Binding TodayCaption}" FontSize="{DynamicResource CaptionFontSize}"
                     Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
        </StackPanel>
        <Button Grid.Column="1" Command="{Binding LoadCommand}" Padding="12,8" VerticalAlignment="Center" Classes="secondary">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16"
                      Foreground="{DynamicResource OnSurfaceBrush}"/>
            <TextBlock Text="Làm mới" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceBrush}"/>
          </StackPanel>
        </Button>
      </Grid>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="4"/>

      <!-- Error state -->
      <Border IsVisible="{Binding FormError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
              Background="{DynamicResource ErrorBgBrush}" BorderBrush="{DynamicResource ErrorBrush}"
              BorderThickness="1" CornerRadius="{DynamicResource CornerRadius8}" Padding="16,12">
        <TextBlock Text="{Binding FormError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
      </Border>

      <StackPanel Spacing="{DynamicResource Spacing24}" IsVisible="{Binding NotLoading}">

        <!-- KPI cards -->
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{DynamicResource Spacing16}">
          <controls:KpiCard Grid.Column="0" Title="Doanh thu hôm nay"
                            Value="{Binding TodayRevenue, StringFormat='{}{0:N0} ₫'}"
                            Subtitle="Đơn đã thanh toán"
                            Icon="{StaticResource IconMoney}"
                            AccentBrush="{DynamicResource PrimaryBrush}"/>
          <controls:KpiCard Grid.Column="1" Title="Đơn hôm nay"
                            Value="{Binding TodayOrders, StringFormat='{}{0}'}"
                            Subtitle="Số đơn phát sinh"
                            Icon="{StaticResource IconShoppingCart}"
                            AccentBrush="{DynamicResource InfoBrush}"/>
          <controls:KpiCard Grid.Column="2" Title="Giá trị TB / đơn"
                            Value="{Binding AverageTicket, StringFormat='{}{0:N0} ₫'}"
                            Subtitle="Doanh thu ÷ số đơn"
                            Icon="{StaticResource IconReceipt}"
                            AccentBrush="{DynamicResource SecondaryBrush}"/>
          <controls:KpiCard Grid.Column="3" Title="Đơn đang xử lý"
                            Value="{Binding OpenOrders, StringFormat='{}{0}'}"
                            Subtitle="Bếp chưa hoàn tất"
                            Icon="{StaticResource IconKitchen}"
                            AccentBrush="{DynamicResource WarningBrush}"/>
        </Grid>

        <!-- Best sellers + side widgets -->
        <Grid ColumnDefinitions="2*,*" ColumnSpacing="{DynamicResource Spacing24}">
          <controls:Card Grid.Column="0" MinHeight="380">
            <StackPanel Spacing="{DynamicResource Spacing16}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="Món bán chạy" FontSize="{DynamicResource SubtitleFontSize}" FontWeight="Bold"
                             Foreground="{DynamicResource OnSurfaceBrush}"/>
                  <TextBlock Text="7 ngày gần nhất · theo doanh thu" FontSize="{DynamicResource CaptionFontSize}"
                             Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Xem báo cáo" Command="{Binding OpenDailySalesCommand}" Padding="8,4" Foreground="{DynamicResource PrimaryBrush}" FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold" VerticalAlignment="Center" Classes="ghost"/>
              </Grid>

              <Grid ColumnDefinitions="28,*,104,84" Margin="8,0">
                <TextBlock Text="#" FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                           Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                <TextBlock Grid.Column="1" Text="Món" Margin="12,0,0,0" FontSize="{DynamicResource CaptionFontSize}"
                           FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                <TextBlock Grid.Column="2" Text="Doanh thu" TextAlignment="Right" FontSize="{DynamicResource CaptionFontSize}"
                           FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                <TextBlock Grid.Column="3" Text="Tỷ trọng" TextAlignment="Right" FontSize="{DynamicResource CaptionFontSize}"
                           FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrush}"/>

              <ItemsControl ItemsSource="{Binding TopProducts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:TopProductRow">
                    <Border Padding="8,10" CornerRadius="{DynamicResource CornerRadius8}" Margin="0,1">
                      <Grid ColumnDefinitions="28,*,104,84">
                        <TextBlock Text="{Binding Rank}" FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0,8,0" TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource OnSurfaceBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Revenue, StringFormat='{}{0:N0} ₫'}" TextAlignment="Right"
                                   FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center"/>
                        <Border Grid.Column="3" Width="84" Height="8" CornerRadius="4" ClipToBounds="True"
                                Background="{DynamicResource SurfaceMutedBrush}" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                          <Border Width="{Binding ShareBarWidth}" Height="8" CornerRadius="4"
                                  Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left"/>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Empty state -->
              <Border IsVisible="{Binding TopProductsEmpty}" Padding="24" CornerRadius="{DynamicResource CornerRadius8}"
                      Background="{DynamicResource BackgroundBrush}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                  <PathIcon Data="{StaticResource IconCoffee}" Width="32" Height="32"
                            Foreground="{DynamicResource OnSurfaceMutedBrush}" Opacity="0.5"/>
                  <TextBlock Text="Chưa có doanh thu trong 7 ngày gần nhất" FontSize="{DynamicResource BodyFontSize}"
                             Foreground="{DynamicResource OnSurfaceMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </controls:Card>

          <StackPanel Grid.Column="1" Spacing="{DynamicResource Spacing24}">
            <!-- Peak hours -->
            <controls:Card Padding="20">
              <StackPanel Spacing="{DynamicResource Spacing12}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Giờ cao điểm" FontSize="{DynamicResource SubtitleFontSize}" FontWeight="Bold"
                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                    <TextBlock Text="Doanh thu theo 2 giờ" FontSize="{DynamicResource CaptionFontSize}"
                               Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                  </StackPanel>
                  <PathIcon Grid.Column="1" Data="{StaticResource IconBarChart}" Width="18" Height="18"
                            Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Height="112">
                  <ItemsControl ItemsSource="{Binding HourlySales}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="8"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:HourlySalesBar">
                        <Grid Height="112" VerticalAlignment="Bottom" ToolTip.Tip="{Binding Tooltip}">
                          <Border Classes="chart-bar" Classes.peak="{Binding IsPeak}" Height="{Binding BarHeight}"
                                  Margin="4,0" CornerRadius="4,4,0,0" VerticalAlignment="Bottom"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>

                <ItemsControl ItemsSource="{Binding HourlySales}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="8"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:HourlySalesBar">
                      <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center"
                                 Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Chưa có doanh thu hôm nay" IsVisible="{Binding HourlySalesEmpty}"
                           FontSize="{DynamicResource CaptionFontSize}" HorizontalAlignment="Center"
                           Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
              </StackPanel>
            </controls:Card>

            <!-- Low stock -->
            <controls:Card Padding="20">
              <StackPanel Spacing="{DynamicResource Spacing12}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Sắp hết hàng" FontSize="{DynamicResource SubtitleFontSize}" FontWeight="Bold"
                             Foreground="{DynamicResource OnSurfaceBrush}"/>
                  <Border Grid.Column="1" Background="{DynamicResource ErrorBgBrush}" CornerRadius="100" Padding="10,4">
                    <TextBlock Text="{Binding LowStockCount, StringFormat='{}{0} món'}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource ErrorBrush}"/>
                  </Border>
                </Grid>

                <ItemsControl ItemsSource="{Binding LowStockItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:MenuItem">
                      <Border Padding="12,10" Margin="0,0,0,8" Background="{DynamicResource BackgroundBrush}"
                              CornerRadius="{DynamicResource CornerRadius8}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource ErrorBrush}"
                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                     FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource OnSurfaceBrush}"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="{Binding Quantity}" FontSize="{DynamicResource CaptionFontSize}"
                                     FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Không có món nào sắp hết" IsVisible="{Binding LowStockEmpty}"
                           FontSize="{DynamicResource CaptionFontSize}" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Foreground="{DynamicResource OnSurfaceMutedBrush}"/>

                <Button Content="Mở kho hàng" Command="{Binding OpenInventoryCommand}" HorizontalAlignment="Stretch" Padding="12,8" Classes="secondary"/>
              </StackPanel>
            </controls:Card>
          </StackPanel>
        </Grid>

        <!-- Quick actions -->
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{DynamicResource Spacing16}">
          <Button Grid.Column="0" Command="{Binding OpenSalesCommand}" HorizontalAlignment="Stretch" Padding="16" Classes="primary">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconAddCircle}" Foreground="{DynamicResource OnPrimaryBrush}" Width="18" Height="18"/>
              <TextBlock Text="Bán hàng" FontWeight="SemiBold"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Command="{Binding OpenTablesCommand}" HorizontalAlignment="Stretch" Padding="16" Classes="secondary">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconTableRestaurant}" Foreground="{DynamicResource OnSurfaceBrush}" Width="18" Height="18"/>
              <TextBlock Text="Sơ đồ bàn"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Command="{Binding OpenInventoryCommand}" HorizontalAlignment="Stretch" Padding="16" Classes="secondary">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconInventory}" Foreground="{DynamicResource OnSurfaceBrush}" Width="18" Height="18"/>
              <TextBlock Text="Kho hàng"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Command="{Binding OpenDailySalesCommand}" HorizontalAlignment="Stretch" Padding="16" Classes="secondary">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconReport}" Foreground="{DynamicResource OnSurfaceBrush}" Width="18" Height="18"/>
              <TextBlock Text="Báo cáo ngày"/>
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
