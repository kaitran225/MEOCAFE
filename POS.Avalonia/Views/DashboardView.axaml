<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:POS.Avalonia.ViewModels"
             xmlns:controls="using:POS.Avalonia.Controls"
             xmlns:models="using:POS.Core.Models"
             x:Class="POS.Avalonia.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Background="{StaticResource BackgroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="32" Margin="32">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="4"/>

      <StackPanel Spacing="32" IsVisible="{Binding NotLoading}">
        <!-- KPI Cards -->
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="24">
          <controls:KpiCard Grid.Column="0" Title="Total Sales"
                            Value="{Binding TotalSales, StringFormat='{}{0:N0} ₫'}"
                            Subtitle=""
                            AccentBrush="{StaticResource PrimaryBrush}"
                            />
          <controls:KpiCard Grid.Column="1" Title="Avg Ticket"
                            Value="{Binding AverageTicket, StringFormat='{}{0:N0} ₫'}"
                            Subtitle=""
                            AccentBrush="{StaticResource PrimaryBrush}"
                            />
          <controls:KpiCard Grid.Column="2" Title="Open Orders"
                            Value="—"
                            Subtitle="Active"
                            AccentBrush="{StaticResource SecondaryBrush}"/>
          <controls:KpiCard Grid.Column="3" Title="Voids"
                            Value="—"
                            Subtitle=""
                            AccentBrush="{StaticResource ErrorBrush}"
                            />
        </Grid>

        <!-- Main content: Top Products + Side widgets; gap 32 -->
        <Grid ColumnDefinitions="2*,*" ColumnSpacing="32" RowDefinitions="Auto">
          <!-- Top Products: Revenue + Trend bar cols, View Report link, min-height -->
          <controls:Card Grid.Column="0" MinHeight="320">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Top Products" FontSize="18" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}"/>
                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0,4" Foreground="{StaticResource PrimaryBrush}">
                  <TextBlock Text="View Report" FontSize="13" FontWeight="SemiBold"/>
                </Button>
              </Grid>
              <!-- Table header: #, Item, Qty, Revenue, Trend -->
              <Grid ColumnDefinitions="40,*,Auto,Auto,100" Margin="0,0,0,4">
                <TextBlock Text="#" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceMutedBrush}"/>
                <TextBlock Grid.Column="1" Text="Item Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceMutedBrush}" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="2" Text="Qty" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceMutedBrush}"/>
                <TextBlock Grid.Column="3" Text="Revenue" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceMutedBrush}"/>
                <TextBlock Grid.Column="4" Text="Trend" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceMutedBrush}"/>
              </Grid>
              <Border Height="1" Background="{StaticResource BorderBrush}"/>
              <ItemsControl ItemsSource="{Binding TopProducts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8,12" Margin="0,2" CornerRadius="{DynamicResource CornerRadius8}">
                      <Grid ColumnDefinitions="32,*,Auto,Auto,100">
                        <Border Width="28" Height="28" CornerRadius="{DynamicResource CornerRadius4}"
                                Background="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center">
                          <PathIcon Data="{StaticResource IconCoffee}" Width="14" Height="14" Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Key}" FontSize="{DynamicResource BodyFontSize}"
                                   Foreground="{StaticResource OnSurfaceBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat='{}{0:N0}'}"
                                   FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="—"
                                   FontSize="{DynamicResource BodyFontSize}"
                                   Foreground="{StaticResource OnSurfaceMutedBrush}" VerticalAlignment="Center"/>
                        <Border Grid.Column="4" Height="8" CornerRadius="4" Background="{StaticResource SurfaceMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" ClipToBounds="True">
                          <Border Width="92" Height="8" CornerRadius="4" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Left" Opacity="0.7"/>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>                  <Border Padding="32,24" Background="{StaticResource SurfaceBrush}"
                      CornerRadius="{DynamicResource CornerRadius8}" HorizontalAlignment="Stretch"
                      IsVisible="{Binding TopProductsEmpty}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                  <PathIcon Data="{StaticResource IconCoffee}" Width="32" Height="32"
                            Foreground="{StaticResource OnSurfaceMutedBrush}" Opacity="0.5"/>
                  <TextBlock Text="No sales this week yet" FontSize="{DynamicResource BodyFontSize}"
                             Foreground="{StaticResource OnSurfaceMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </controls:Card>

          <!-- Right side widgets -->
          <StackPanel Grid.Column="1" Spacing="24" Margin="0,0,0,0">
            <!-- Peak Hours placeholder -->
            <controls:Card Padding="20">
              <StackPanel Spacing="{DynamicResource Spacing16}">
                <TextBlock Text="Peak Hours" FontSize="{DynamicResource SubtitleFontSize}"
                           FontWeight="{StaticResource SubtitleFontWeight}" Foreground="{StaticResource OnSurfaceBrush}"/>
                <Grid Height="160" ColumnDefinitions="*,*,*,*,*,*" VerticalAlignment="Bottom">
                  <Border Grid.Column="0" Background="{StaticResource SurfaceMutedBrush}"
                          CornerRadius="4,4,0,0" Height="36" VerticalAlignment="Bottom" Margin="2,0"/>
                  <Border Grid.Column="1" Background="{StaticResource SurfaceMutedBrush}"
                          CornerRadius="4,4,0,0" Height="60" VerticalAlignment="Bottom" Margin="2,0"/>
                  <Border Grid.Column="2" Background="{StaticResource PrimaryBrush}"
                          CornerRadius="4,4,0,0" Height="96" VerticalAlignment="Bottom" Margin="2,0"/>
                  <Border Grid.Column="3" Background="{StaticResource SurfaceMutedBrush}"
                          CornerRadius="4,4,0,0" Height="72" VerticalAlignment="Bottom" Margin="2,0"/>
                  <Border Grid.Column="4" Background="{StaticResource SurfaceMutedBrush}"
                          CornerRadius="4,4,0,0" Height="48" VerticalAlignment="Bottom" Margin="2,0"/>
                  <Border Grid.Column="5" Background="{StaticResource SurfaceMutedBrush}"
                          CornerRadius="4,4,0,0" Height="24" VerticalAlignment="Bottom" Margin="2,0"/>
                </Grid>
                <Grid ColumnDefinitions="*,*,*,*">
                  <TextBlock Text="10am" FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" HorizontalAlignment="Left"/>
                  <TextBlock Grid.Column="1" Text="12pm" FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="2pm" FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="4pm" FontSize="11" Foreground="{StaticResource OnSurfaceMutedBrush}" HorizontalAlignment="Right"/>
                </Grid>
              </StackPanel>
            </controls:Card>

            <!-- Low Stock: colored dot, item name, quantity, Order button -->
            <controls:Card Padding="20">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Low Stock" FontSize="18" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}"/>
                  <Border Grid.Column="1" Background="{StaticResource ErrorBgBrush}" CornerRadius="100" Padding="8,4">
                    <TextBlock Text="{Binding LowStockCount, StringFormat='{}{0} items'}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource ErrorBrush}"/>
                  </Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding LowStockItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:MenuItem">
                      <Border Padding="12,10" Margin="0,0,0,8" Background="{StaticResource BackgroundBrush}"
                              CornerRadius="{DynamicResource CornerRadius8}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                          <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource BodyFontSize}"
                                     Foreground="{StaticResource OnSurfaceBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat='{}{0}'}"
                                     FontSize="{DynamicResource CaptionFontSize}" Foreground="{StaticResource OnSurfaceMutedBrush}"
                                     VerticalAlignment="Center" Margin="8,0"/>
                          <Button Grid.Column="3" Content="Order" Padding="10,6" FontSize="12" Classes="primary"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No low stock items" FontSize="{DynamicResource CaptionFontSize}"
                           Foreground="{StaticResource OnSurfaceMutedBrush}" IsVisible="{Binding LowStockEmpty}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
              </StackPanel>
            </controls:Card>
          </StackPanel>
        </Grid>

        <!-- Quick Actions: gap 16px, top spacing 32px -->
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16" RowDefinitions="Auto" Margin="0,32,0,0">
          <Button Grid.Column="0" HorizontalAlignment="Stretch" Padding="16"
                  Background="{StaticResource BlackBrush}" Foreground="{StaticResource OnPrimaryBrush}"
                  CornerRadius="{DynamicResource CornerRadius12}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconAddCircle}" Foreground="{StaticResource OnPrimaryBrush}" Width="18" Height="18"/>
              <TextBlock Text="New Order" FontWeight="SemiBold"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="1" HorizontalAlignment="Stretch" Padding="16"
                  Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource OnSurfaceBrush}"
                  CornerRadius="{DynamicResource CornerRadius12}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconTableRestaurant}" Foreground="{StaticResource OnSurfaceBrush}" Width="18" Height="18"/>
              <TextBlock Text="Manage Tables"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="2" HorizontalAlignment="Stretch" Padding="16"
                  Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource OnSurfaceBrush}"
                  CornerRadius="{DynamicResource CornerRadius12}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconPerson}" Foreground="{StaticResource OnSurfaceBrush}" Width="18" Height="18"/>
              <TextBlock Text="Add Customer"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="3" HorizontalAlignment="Stretch" Padding="16"
                  Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource OnSurfaceBrush}"
                  CornerRadius="{DynamicResource CornerRadius12}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconPrint}" Foreground="{StaticResource OnSurfaceBrush}" Width="18" Height="18"/>
              <TextBlock Text="Day Report"/>
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
