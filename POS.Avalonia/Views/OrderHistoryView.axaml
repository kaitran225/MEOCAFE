<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:POS.Avalonia.ViewModels"
             xmlns:core="using:POS.Core.Models"
             xmlns:controls="using:POS.Avalonia.Controls"
             x:Class="POS.Avalonia.Views.OrderHistoryView" x:Name="Root" x:DataType="vm:OrderHistoryViewModel"
             Background="{DynamicResource BackgroundBrush}">
  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="{DynamicResource Spacing16}" Margin="24,24,24,0">
      <controls:PageTitle Title="Order History">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing8}">
          <Button Command="{Binding LoadOrdersCommand}" Padding="12,8" Classes="secondary">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16"
                        Foreground="{DynamicResource OnSurfaceBrush}"/>
              <TextBlock Text="Refresh"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </controls:PageTitle>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="4"/>
    </StackPanel>

    <!-- Content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="24,16,24,24">
      <StackPanel Spacing="{DynamicResource Spacing24}">
        <!-- Search & filter -->
        <controls:Card Padding="16,12">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
            <TextBox Grid.Column="0" Text="{Binding SearchText}" Watermark="Search by ID or date..."
                     MinWidth="180"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBlock Text="From" VerticalAlignment="Center" FontSize="{DynamicResource CaptionFontSize}"
                         Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
              <CalendarDatePicker SelectedDate="{Binding FilterDateFrom}" Width="140" Watermark="Start"/>
              <TextBlock Text="To" VerticalAlignment="Center" FontSize="{DynamicResource CaptionFontSize}"
                         Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
              <CalendarDatePicker SelectedDate="{Binding FilterDateTo}" Width="140" Watermark="End"/>
            </StackPanel>
            <Button Grid.Column="2" Command="{Binding LoadOrdersCommand}" Padding="12,8" Classes="primary">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14"
                          Foreground="{DynamicResource OnPrimaryBrush}"/>
                <TextBlock Text="Apply"/>
              </StackPanel>
            </Button>
          </Grid>
        </controls:Card>

        <!-- Main: Table + Detail Panel -->
        <Grid ColumnDefinitions="*,360" RowDefinitions="*">

          <!-- Orders Data Table -->
          <controls:Card Grid.Column="0" Margin="0,0,16,0" Padding="24">
            <StackPanel Spacing="{DynamicResource Spacing16}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Orders"
                           FontSize="{DynamicResource SubtitleFontSize}"
                           FontWeight="{StaticResource SubtitleFontWeight}"
                           Foreground="{DynamicResource OnSurfaceBrush}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding PaginationSummary}"
                           FontSize="{DynamicResource CaptionFontSize}"
                           Foreground="{DynamicResource OnSurfaceMutedBrush}"
                           VerticalAlignment="Center"/>
              </Grid>

              <!-- Table Header -->
              <Grid ColumnDefinitions="80,140,100,80,120,100" Margin="12,0">
                <TextBlock Grid.Column="0" Text="Order ID"
                           FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                           Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                <TextBlock Grid.Column="1" Text="Date &amp; Time"
                           FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                           Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                <TextBlock Grid.Column="2" Text="Service"
                           FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                           Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                <TextBlock Grid.Column="3" Text="Items"
                           FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                           Foreground="{DynamicResource OnSurfaceMutedBrush}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Total"
                           FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                           Foreground="{DynamicResource OnSurfaceMutedBrush}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="5" Text="Status"
                           FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                           Foreground="{DynamicResource OnSurfaceMutedBrush}" HorizontalAlignment="Center"/>
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrush}"/>

              <!-- Table rows -->
              <ItemsControl ItemsSource="{Binding DisplayedOrders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:Order">
                    <Button Command="{Binding #Root.DataContext.SelectOrderCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,1" Classes="ghost">
                      <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                          <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                        </Style>
                      </Button.Styles>
                      <Border Padding="12,10" CornerRadius="{DynamicResource CornerRadius8}">
                        <Grid ColumnDefinitions="80,140,100,80,120,100">
                          <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat='#{0}'}"
                                     FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource PrimaryBrush}"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yy HH:mm}'}"
                                     FontSize="{DynamicResource BodyFontSize}"
                                     Foreground="{DynamicResource OnSurfaceBrush}"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="{Binding ServiceType}"
                                     FontSize="{DynamicResource BodyFontSize}"
                                     Foreground="{DynamicResource OnSurfaceBrush}"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="3" Text="{Binding OrderDetails.Count}"
                                     FontSize="{DynamicResource BodyFontSize}"
                                     Foreground="{DynamicResource OnSurfaceBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="4" Text="{Binding TotalPrice, StringFormat='{}{0:N0} ₫'}"
                                     FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource OnSurfaceBrush}"
                                     HorizontalAlignment="Right" VerticalAlignment="Center"/>
                          <Panel Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:StatusBadge Text="{Binding KitchenStatus}"
                                                  BadgeBrush="{DynamicResource SuccessBrush}"/>
                          </Panel>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Empty state -->
              <controls:EmptyState Icon="{StaticResource IconHistory}"
                                   Title="No orders found"
                                   Hint="Thử đổi khoảng ngày hoặc từ khoá tìm kiếm."
                                   IsVisible="{Binding !DisplayedOrders.Count}"/>
            </StackPanel>
          </controls:Card>

          <!-- Detail Side Panel -->
          <Border Grid.Column="1"
                  Background="{DynamicResource SurfaceBrush}"
                  CornerRadius="{DynamicResource CornerRadius12}" Padding="24"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  BoxShadow="0 2 12 0 #0F000000">
            <StackPanel Spacing="{DynamicResource Spacing16}">
              <TextBlock Text="Order Detail"
                         FontSize="{DynamicResource SubtitleFontSize}"
                         FontWeight="{StaticResource SubtitleFontWeight}"
                         Foreground="{DynamicResource OnSurfaceBrush}"/>
              <Border Height="1" Background="{DynamicResource BorderBrush}"/>

              <!-- Selected Order Info -->
              <StackPanel IsVisible="{Binding SelectedOrder, Converter={x:Static ObjectConverters.IsNotNull}}"
                          Spacing="{DynamicResource Spacing16}">
                <Border Background="{DynamicResource SurfaceMutedBrush}"
                        CornerRadius="{DynamicResource CornerRadius8}" Padding="16,12">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding SelectedOrder.Id, StringFormat='Order #{0}'}"
                                 FontSize="{DynamicResource SubtitleFontSize}" FontWeight="Bold"
                                 Foreground="{DynamicResource OnSurfaceBrush}"/>
                      <controls:StatusBadge Grid.Column="1"
                                            Text="{Binding SelectedOrder.KitchenStatus}"
                                            BadgeBrush="{DynamicResource SuccessBrush}"/>
                    </Grid>
                    <TextBlock Text="{Binding SelectedOrder.CreatedAt, StringFormat='{}{0:dddd, dd MMM yyyy HH:mm}'}"
                               FontSize="{DynamicResource CaptionFontSize}"
                               Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                  </StackPanel>
                </Border>

                <!-- Order Properties -->
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Service Type" FontSize="{DynamicResource CaptionFontSize}"
                               Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.ServiceType}"
                               FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Items" FontSize="{DynamicResource CaptionFontSize}"
                               Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.OrderDetails.Count}"
                               FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Table" FontSize="{DynamicResource CaptionFontSize}"
                               Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.TableId, FallbackValue='—'}"
                               FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Subtotal" FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.TotalPrice, StringFormat='{}{0:N0} ₫'}"
                               FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Delivery Fee" FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.DeliveryFee, StringFormat='{}{0:N0} ₫'}"
                               FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource BorderBrush}"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Grand Total" FontSize="{DynamicResource BodyFontSize}"
                               FontWeight="Bold" Foreground="{DynamicResource OnSurfaceBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedOrder.GrandTotal, StringFormat='{}{0:N0} ₫'}"
                               FontSize="{DynamicResource SubtitleFontSize}" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                  </Grid>
                </StackPanel>

                <!-- Note -->
                <Border Background="{DynamicResource SurfaceMutedBrush}"
                        CornerRadius="{DynamicResource CornerRadius8}" Padding="12,10"
                        IsVisible="{Binding SelectedOrder.Note, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Note" FontSize="{DynamicResource CaptionFontSize}"
                               FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
                    <TextBlock Text="{Binding SelectedOrder.Note}"
                               FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <!-- Actions -->
                <Border Height="1" Background="{DynamicResource BorderBrush}"/>
                <StackPanel Spacing="{DynamicResource Spacing8}">
                  <Button Command="{Binding ReprintCommand}" HorizontalAlignment="Stretch" Padding="12,10" BorderThickness="0" Classes="secondary">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                      <PathIcon Data="{StaticResource IconPrint}" Width="16" Height="16"
                                Foreground="{DynamicResource OnSurfaceBrush}"/>
                      <TextBlock Text="Reprint Receipt" Foreground="{DynamicResource OnSurfaceBrush}"/>
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding ReprintKitchenTicketCommand}" HorizontalAlignment="Stretch" Padding="12,10" BorderThickness="0" Classes="secondary">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                      <PathIcon Data="{StaticResource IconKitchen}" Width="16" Height="16"
                                Foreground="{DynamicResource OnSurfaceBrush}"/>
                      <TextBlock Text="Reprint Kitchen Ticket" Foreground="{DynamicResource OnSurfaceBrush}"/>
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding OpenRefundCommand}" HorizontalAlignment="Stretch" Padding="12,10" Background="{DynamicResource ErrorBgBrush}" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                      <PathIcon Data="{StaticResource IconCash}" Width="16" Height="16"
                                Foreground="{DynamicResource ErrorBrush}"/>
                      <TextBlock Text="Issue Refund" Foreground="{DynamicResource ErrorBrush}"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>

              <!-- No Selection Placeholder -->
              <StackPanel IsVisible="{Binding SelectedOrder, Converter={x:Static ObjectConverters.IsNull}}"
                          Spacing="12" Margin="0,24">
                <PathIcon Data="{StaticResource IconReceipt}" Width="40" Height="40"
                          Foreground="{DynamicResource OnSurfaceMutedBrush}" Opacity="0.3"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Select an order" FontSize="{DynamicResource BodyFontSize}"
                           FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceMutedBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Click on an order row to view its details and available actions."
                           FontSize="{DynamicResource CaptionFontSize}"
                           Foreground="{DynamicResource OnSurfaceMutedBrush}" Opacity="0.7"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Pagination -->
        <controls:Card Padding="12,8" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
            <Button Command="{Binding PrevPageCommand}" Padding="12,8" Classes="secondary">
              <TextBlock Text="Previous"/>
            </Button>
            <TextBlock Text="{Binding PaginationSummary}" VerticalAlignment="Center"
                       FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
            <Button Command="{Binding NextPageCommand}" Padding="12,8" Classes="secondary">
              <TextBlock Text="Next"/>
            </Button>
          </StackPanel>
        </controls:Card>
      </StackPanel>
    </ScrollViewer>

    <!-- Refund modal -->
    <controls:ModalOverlay Grid.Row="0" Grid.RowSpan="2" IsOpen="{Binding IsRefundOpen}" Title="Issue Refund">
      <StackPanel Spacing="{DynamicResource Spacing16}" MinWidth="380">
        <Border Background="{DynamicResource SurfaceMutedBrush}"
                CornerRadius="{DynamicResource CornerRadius8}" Padding="16,12">
          <StackPanel Spacing="4">
            <TextBlock Text="Refunding Order" FontSize="{DynamicResource CaptionFontSize}"
                       Foreground="{DynamicResource OnSurfaceMutedBrush}"/>
            <TextBlock Text="{Binding SelectedOrder.Id, StringFormat='Order #{0}'}"
                       FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                       Foreground="{DynamicResource OnSurfaceBrush}"/>
            <TextBlock FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource OnSurfaceMutedBrush}">
              <Run Text="Original total: "/>
              <Run Text="{Binding SelectedOrder.TotalPrice, StringFormat='{}{0:N0} ₫'}"/>
            </TextBlock>
          </StackPanel>
        </Border>
        <StackPanel Spacing="4">
          <TextBlock Text="Refund Amount" FontSize="{DynamicResource CaptionFontSize}"
                     FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}"/>
          <TextBox Text="{Binding RefundAmountText}" Watermark="Enter amount"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Reason" FontSize="{DynamicResource CaptionFontSize}"
                     FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}"/>
          <TextBox Text="{Binding RefundReason}" Watermark="Reason for refund"
                   MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Spacing8}">
            <Button Command="{Binding CloseRefundCommand}" Padding="16,10" Classes="secondary">
              <TextBlock Text="Cancel"/>
            </Button>
            <Button Command="{Binding ConfirmRefundCommand}" Padding="16,10" Classes="danger">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14"
                          Foreground="{DynamicResource OnPrimaryBrush}"/>
                <TextBlock Text="Confirm Refund"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </controls:ModalOverlay>

  </Grid>
</UserControl>
