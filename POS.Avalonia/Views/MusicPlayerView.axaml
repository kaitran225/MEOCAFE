<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:POS.Avalonia.ViewModels"
             xmlns:controls="using:POS.Avalonia.Controls"
             x:Class="POS.Avalonia.Views.MusicPlayerView"
             x:DataType="vm:MusicPlayerViewModel"
             Background="{StaticResource BackgroundBrush}">
  <Border Background="{StaticResource BackgroundBrush}">
    <Grid ColumnDefinitions="3*,2*">

      <!-- Left: Now Playing -->
      <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Margin="0,0,1,0">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{DynamicResource Spacing32}">

          <!-- Album Art Placeholder -->
          <Border Width="220" Height="220" CornerRadius="{DynamicResource CornerRadius16}"
                  Background="{StaticResource BackgroundBrush}"
                  BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2"
                  HorizontalAlignment="Center"
                  BoxShadow="0 8 32 0 #40000000">
            <PathIcon Data="{StaticResource IconMusic}" Width="80" Height="80"
                      Foreground="{StaticResource PrimaryBrush}" Opacity="0.6"/>
          </Border>

          <!-- Track Info -->
          <StackPanel Spacing="{DynamicResource Spacing8}" HorizontalAlignment="Center">
            <TextBlock Text="{Binding CurrentTrack}"
                       FontSize="{DynamicResource LargeTitleFontSize}" FontWeight="Bold"
                       Foreground="{StaticResource OnPrimaryBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Artist}"
                       FontSize="{DynamicResource SubtitleFontSize}"
                       Foreground="{StaticResource OnSurfaceMutedBrush}"
                       HorizontalAlignment="Center"/>
          </StackPanel>

          <!-- Progress Bar -->
          <StackPanel Spacing="{DynamicResource Spacing8}" Width="340">
            <Border Height="6" CornerRadius="3" Background="{StaticResource BorderBrush}">
              <Border Background="{StaticResource PrimaryBrush}" CornerRadius="3"
                      HorizontalAlignment="Left" Width="{Binding Progress, FallbackValue=120}"/>
            </Border>
            <Grid ColumnDefinitions="*,*">
              <TextBlock Grid.Column="0" Text="1:18" FontSize="11"
                         Foreground="{StaticResource OnSurfaceMutedBrush}"/>
              <TextBlock Grid.Column="1" Text="3:42" FontSize="11"
                         Foreground="{StaticResource OnSurfaceMutedBrush}"
                         HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>

          <!-- Playback Controls -->
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing24}"
                      HorizontalAlignment="Center">
            <Button Command="{Binding PreviousCommand}" Background="Transparent"
                    BorderThickness="0" Padding="12" Cursor="Hand">
              <PathIcon Data="{StaticResource IconChevronLeft}" Width="28" Height="28"
                        Foreground="{StaticResource OnPrimaryBrush}"/>
            </Button>

            <Button Command="{Binding PlayPauseCommand}"
                    Width="64" Height="64" CornerRadius="32"
                    Background="{StaticResource PrimaryBrush}"
                    BorderThickness="0" Padding="0" Cursor="Hand"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
              <Panel>
                <PathIcon Data="{StaticResource IconChevronRight}" Width="28" Height="28"
                          Foreground="{StaticResource OnPrimaryBrush}"
                          IsVisible="{Binding !IsPlaying}"/>
                <TextBlock Text="❚❚" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource OnPrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding IsPlaying}"/>
              </Panel>
            </Button>

            <Button Command="{Binding NextCommand}" Background="Transparent"
                    BorderThickness="0" Padding="12" Cursor="Hand">
              <PathIcon Data="{StaticResource IconChevronRight}" Width="28" Height="28"
                        Foreground="{StaticResource OnPrimaryBrush}"/>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Right: Playlist -->
      <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}" Padding="24">
        <StackPanel Spacing="{DynamicResource Spacing16}">
          <StackPanel Spacing="2">
            <TextBlock Text="Playlist"
                       FontSize="{DynamicResource TitleFontSize}" FontWeight="Bold"
                       Foreground="{StaticResource OnPrimaryBrush}"/>
            <TextBlock Text="{Binding Playlist.Count, StringFormat='{}{0} tracks'}"
                       FontSize="{DynamicResource CaptionFontSize}"
                       Foreground="{StaticResource OnSurfaceMutedBrush}"/>
          </StackPanel>

          <Border Height="1" Background="{StaticResource BorderBrush}"/>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListBox ItemsSource="{Binding Playlist}"
                     SelectedItem="{Binding SelectedTrack}"
                     Background="Transparent">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="12,10"/>
                  <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius8}"/>
                  <Setter Property="Margin" Value="0,2"/>
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                  <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                            Background="{StaticResource SurfaceMutedBrush}" Margin="0,0,12,0">
                      <PathIcon Data="{StaticResource IconMusic}" Width="16" Height="16"
                                Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}"
                                 FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                 Foreground="{StaticResource OnPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Artist}"
                                 FontSize="{DynamicResource CaptionFontSize}"
                                 Foreground="{StaticResource OnSurfaceMutedBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Duration}"
                               FontSize="{DynamicResource CaptionFontSize}"
                               Foreground="{StaticResource OnSurfaceMutedBrush}"
                               VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </StackPanel>
      </Border>

    </Grid>
  </Border>
</UserControl>
