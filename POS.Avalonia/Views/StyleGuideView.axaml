            <Border Width="52" Height="52" CornerRadius="{DynamicResource CornerRadius8}" Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14">
              <PathIcon Data="{StaticResource IconNotification}" Width="24" Height="24" Foreground="{DynamicResource OnSurfaceBrush}"/>
            </Border>
            <TextBlock Text="Bell" FontSize="9" TextAlignment="Center" Foreground="{DynamicResource OnSurfaceMutedBrush}" MaxWidth="56"/>
          </StackPanel>
        </WrapPanel>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
