              <PathIcon Data="{StaticResource IconCost}" Width="24" Height="24" Foreground="{DynamicResource OnSurfaceBrush}"/>
            </Border>
            <TextBlock Text="Cost" FontSize="9" TextAlignment="Center" Foreground="{DynamicResource OnSurfaceMutedBrush}" MaxWidth="56"/>
