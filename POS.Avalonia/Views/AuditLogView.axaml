<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:POS.Avalonia.ViewModels"
             xmlns:core="using:POS.Core.Models"
             xmlns:controls="using:POS.Avalonia.Controls"
             x:Class="POS.Avalonia.Views.AuditLogView" x:DataType="vm:AuditLogViewModel"
             Background="{StaticResource BackgroundBrush}">
  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="{DynamicResource Spacing16}" Margin="24,24,24,0">
      <controls:PageTitle Title="Audit Log">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing8}">
          <Button Padding="12,8"
                  Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource OnSurfaceBrush}"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{DynamicResource CornerRadius8}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconExport}" Width="16" Height="16"
                        Foreground="{StaticResource OnSurfaceBrush}"/>
              <TextBlock Text="Export"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding LoadCommand}" Classes="primary" Padding="12,8"
                  CornerRadius="{DynamicResource CornerRadius8}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16"
                        Foreground="{StaticResource OnPrimaryBrush}"/>
              <TextBlock Text="Refresh"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </controls:PageTitle>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="4"/>
    </StackPanel>

    <!-- Content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="24,16,24,24">
      <StackPanel Spacing="{DynamicResource Spacing24}">
        <!-- Filter bar -->
        <controls:Card Padding="20,16">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource IconFilter}" Width="18" Height="18"
                    Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"
                    Margin="0,0,16,0"/>

          <!-- Date From -->
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="From" FontSize="{DynamicResource CaptionFontSize}"
                       Foreground="{StaticResource OnSurfaceMutedBrush}"/>
            <CalendarDatePicker SelectedDate="{Binding FilterFrom}"
                                Width="150" Watermark="Start date"/>
          </StackPanel>

          <!-- Date To -->
          <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="To" FontSize="{DynamicResource CaptionFontSize}"
                       Foreground="{StaticResource OnSurfaceMutedBrush}"/>
            <CalendarDatePicker SelectedDate="{Binding FilterTo}"
                                Width="150" Watermark="End date"/>
          </StackPanel>

          <Border Grid.Column="3" Width="1" Height="36"
                  Background="{StaticResource BorderBrush}" VerticalAlignment="Center"
                  Margin="0,0,16,0"/>

          <!-- User Filter -->
          <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="User" FontSize="{DynamicResource CaptionFontSize}"
                       Foreground="{StaticResource OnSurfaceMutedBrush}"/>
            <TextBox Text="{Binding FilterUser}" Watermark="Filter by user"
                     Width="140" Padding="8,6"/>
          </StackPanel>

          <!-- Action Type Filter -->
          <StackPanel Grid.Column="5" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="Action" FontSize="{DynamicResource CaptionFontSize}"
                       Foreground="{StaticResource OnSurfaceMutedBrush}"/>
            <TextBox Text="{Binding FilterAction}" Watermark="Filter by action"
                     Width="140" Padding="8,6"/>
          </StackPanel>

          <Panel Grid.Column="6"/>

          <!-- Apply Filter Button -->
          <Button Grid.Column="7" Command="{Binding LoadCommand}"
                  Padding="16,10" VerticalAlignment="Bottom" Margin="0,0,0,0"
                  Background="{StaticResource PrimaryBrush}" Foreground="{StaticResource OnPrimaryBrush}"
                  CornerRadius="{DynamicResource CornerRadius8}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16"
                        Foreground="{StaticResource OnPrimaryBrush}"/>
              <TextBlock Text="Apply Filters"/>
            </StackPanel>
          </Button>
        </Grid>
        </controls:Card>

        <!-- Results count -->
        <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Entries.Count, StringFormat='{}{0} entries found'}"
                   FontSize="{DynamicResource CaptionFontSize}"
                   Foreground="{StaticResource OnSurfaceMutedBrush}"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- Data table card -->
        <controls:Card Padding="24">
        <StackPanel Spacing="{DynamicResource Spacing16}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Activity Log"
                       FontSize="{DynamicResource SubtitleFontSize}"
                       FontWeight="{StaticResource SubtitleFontWeight}"
                       Foreground="{StaticResource OnSurfaceBrush}"/>
            <Border Grid.Column="1" Background="{StaticResource SurfaceMutedBrush}"
                    CornerRadius="100" Padding="10,4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconAuditLog}" Width="14" Height="14"
                          Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="{Binding Entries.Count, StringFormat='{}{0} records'}"
                           FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Table Header -->
          <Grid ColumnDefinitions="150,120,120,100,*" Margin="12,0">
            <TextBlock Grid.Column="0" Text="Timestamp"
                       FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                       Foreground="{StaticResource OnSurfaceMutedBrush}"/>
            <TextBlock Grid.Column="1" Text="User"
                       FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                       Foreground="{StaticResource OnSurfaceMutedBrush}"/>
            <TextBlock Grid.Column="2" Text="Action"
                       FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                       Foreground="{StaticResource OnSurfaceMutedBrush}"/>
            <TextBlock Grid.Column="3" Text="Entity"
                       FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                       Foreground="{StaticResource OnSurfaceMutedBrush}"/>
            <TextBlock Grid.Column="4" Text="Details"
                       FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                       Foreground="{StaticResource OnSurfaceMutedBrush}"/>
          </Grid>
          <Border Height="1" Background="{StaticResource BorderBrush}"/>

          <!-- Table Rows -->
          <ItemsControl ItemsSource="{Binding Entries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:AuditLogEntry">
                <Border Padding="12,12" Margin="0,1" CornerRadius="{DynamicResource CornerRadius8}"
                        Background="Transparent">
                  <Border.Styles>
                    <Style Selector="Border:pointerover">
                      <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                    </Style>
                  </Border.Styles>
                  <Grid ColumnDefinitions="150,120,120,100,*">
                    <!-- Timestamp -->
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy}'}"
                                 FontSize="{DynamicResource BodyFontSize}"
                                 Foreground="{StaticResource OnSurfaceBrush}"/>
                      <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm:ss}'}"
                                 FontSize="{DynamicResource CaptionFontSize}"
                                 Foreground="{StaticResource OnSurfaceMutedBrush}"/>
                    </StackPanel>
                    <!-- User -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Border Width="28" Height="28" CornerRadius="100"
                              Background="{StaticResource SurfaceMutedBrush}">
                        <PathIcon Data="{StaticResource IconPerson}" Width="14" Height="14"
                                  Foreground="{StaticResource PrimaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <TextBlock Text="{Binding Username}"
                                 FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                 Foreground="{StaticResource OnSurfaceBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Action -->
                    <Panel Grid.Column="2" VerticalAlignment="Center">
                      <controls:StatusBadge Text="{Binding Action}"
                                            BadgeBrush="{StaticResource SecondaryBrush}"/>
                    </Panel>
                    <!-- Entity -->
                    <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding EntityType, FallbackValue='—'}"
                                 FontSize="{DynamicResource BodyFontSize}"
                                 Foreground="{StaticResource OnSurfaceBrush}"/>
                      <TextBlock Text="{Binding EntityId, StringFormat='ID: {0}', FallbackValue=''}"
                                 FontSize="{DynamicResource CaptionFontSize}"
                                 Foreground="{StaticResource OnSurfaceMutedBrush}"
                                 IsVisible="{Binding EntityId, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                    <!-- Details -->
                    <TextBlock Grid.Column="4" Text="{Binding Details, FallbackValue='—'}"
                               FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{StaticResource OnSurfaceMutedBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Empty State -->
          <Border Padding="32,24" Background="{StaticResource BackgroundBrush}"
                  CornerRadius="{DynamicResource CornerRadius8}" HorizontalAlignment="Stretch"
                  IsVisible="{Binding !Entries.Count}">
            <StackPanel HorizontalAlignment="Center" Spacing="8">
              <PathIcon Data="{StaticResource IconAuditLog}" Width="32" Height="32"
                        Foreground="{StaticResource OnSurfaceMutedBrush}" Opacity="0.5"/>
              <TextBlock Text="No audit log entries found" FontSize="{DynamicResource BodyFontSize}"
                         Foreground="{StaticResource OnSurfaceMutedBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="Adjust your filters and try again."
                         FontSize="{DynamicResource CaptionFontSize}"
                         Foreground="{StaticResource OnSurfaceMutedBrush}" Opacity="0.7"
                         HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </controls:Card>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
